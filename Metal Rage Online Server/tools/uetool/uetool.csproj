<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline reader for the decrypted client packages (~/mro-decrypted/*.u).
       Needs UELib built for net8.0 at ~/tools/Unreal-Library (see Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Eliot.UELib">
      <HintPath>$(HOME)/tools/Unreal-Library/src/bin/Release/net8.0/Eliot.UELib.dll</HintPath>
    </Reference>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.8" />
  </ItemGroup>
</Project>
